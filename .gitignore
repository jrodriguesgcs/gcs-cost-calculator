# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code: machine-specific plugin/skill artifacts (per-user hook
# wiring, platform-specific compiled binaries) — not portable across
# machines, shouldn't be committed. See the impeccable skill's own
# scripts/bin/<os>-<arch>/ layout.
/.claude/settings.local.json
/.claude/skills/*/scripts/bin/

# scripts/render-all-programs.ts (scripts/README.md): tsc build output and
# the batch-rendered QA PDFs it writes — both generated, not source.
/.scripts-build/
