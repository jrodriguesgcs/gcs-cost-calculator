{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "../.scripts-build",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../lib/**/*.ts", "./render-all-programs.ts"]
}
